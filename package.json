{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && tsx scripts/prerender.tsx && tsx scripts/validate-prerender.ts",
    "validate:prerender": "tsx scripts/validate-prerender.ts",
    "preview": "vite preview",
    "start": "tsx server.ts",
    "cf:dev": "npm run build && wrangler pages dev dist",
    "cf:deploy": "npm run build && wrangler pages deploy dist --project-name orthocareclinic",
    "cf:d1:local": "wrangler d1 migrations apply orthocareclinic --local",
    "cf:d1:remote": "wrangler d1 migrations apply orthocareclinic --remote",
    "test:pages": "node scripts/validate-pages.mjs",
    "test:backup-restore": "node scripts/test-d1-backup-restore.mjs",
    "d1:restore-drill": "node scripts/test-d1-backup-restore.mjs",
    "backup:d1": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup-d1.ps1",
    "clean": "node -e \"const fs = require('node:fs'); fs.rmSync('dist', { recursive: true, force: true }); fs.rmSync('server.js', { force: true });\"",
    "lint": "tsc --noEmit",
    "images:optimize": "tsx scripts/optimize-images.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.156.0"
  }
}
